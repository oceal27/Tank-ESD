# Salin jadi .env.local untuk dijalankan di laptop (npm run dev).
# Di Vercel, isi lewat Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-RAHASIA
NEXT_PUBLIC_DEVICE_ID=tank-01
